# Copy to .env and fill in. NEVER commit the real .env.

# --- Upstox Developer App (https://account.upstox.com/developer/apps) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback
# Filled in automatically after the OAuth login flow:
UPSTOX_ACCESS_TOKEN=

# --- Trading mode: backtest | paper | live ---
# Defaults to paper for safety. Set to "live" only when you mean real money.
TRADING_MODE=paper

# --- Capital & risk (INR) ---
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_CONCURRENT_POSITIONS=3
SQUARE_OFF_TIME=15:15
# Bank profit and stop for the day once daily P&L hits this (INR). 0 = off.
DAILY_PROFIT_TARGET_INR=2000

# --- ORB strategy tuning (optional; defaults are sensible) ---
ORB_OPENING_RANGE_MINUTES=15
ORB_TARGET_R=2.0
ORB_MIN_RANGE_PCT=0.0015   # skip days whose opening range is narrower than this
ORB_MAX_RANGE_PCT=0.05     # skip gap/news-distorted wide ranges (0 = off)
ORB_VOLUME_MULT=1.0        # breakout volume vs avg opening-range volume (0 = off)
ORB_BREAKOUT_BUFFER_PCT=0.0005  # require a decisive break past the range, not a poke
USE_INDEX_FILTER=true      # only go long when Nifty is up, short when it's down

# Assumed monthly infra cost (VM etc.) for the break-even tracker.
MONTHLY_INFRA_COST_INR=500

# --- OPTIONAL: unattended TOTP auto-login (security-sensitive) ---
# Only set these on a host you fully control. Requires Upstox 2FA set to an
# Authenticator-app TOTP, and requirements-autologin.txt installed.
# Leaving any blank keeps the safe manual login (python -m scripts.login).
UPSTOX_MOBILE=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# --- OPTIONAL: notifications (READY alert + daily summary) ---
# Telegram (easiest on phone): create a bot via @BotFather for the token, and
# get your chat id from @userinfobot. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (alternative): SMTP details. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# Send an end-of-day summary ping (true/false).
NOTIFY_DAILY_SUMMARY=true
